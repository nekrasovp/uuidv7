import builtins
import uuid
from collections.abc import Iterable

class UUID7Obj:
    @property
    def int(self) -> builtins.int: ...
    @property
    def bytes(self) -> builtins.bytes: ...
    @property
    def bytes_le(self) -> builtins.bytes: ...
    @property
    def hex(self) -> builtins.str: ...
    @property
    def time(self) -> builtins.int: ...
    @property
    def timestamp(self) -> builtins.int: ...
    @property
    def urn(self) -> builtins.str: ...
    @property
    def version(self) -> builtins.int: ...
    @property
    def variant(self) -> builtins.str: ...
    @property
    def fields(
        self,
    ) -> tuple[
        builtins.int,
        builtins.int,
        builtins.int,
        builtins.int,
        builtins.int,
        builtins.int,
    ]: ...
    def __str__(self) -> builtins.str: ...
    def __int__(self) -> builtins.int: ...
    def __bytes__(self) -> builtins.bytes: ...
    def __index__(self) -> builtins.int: ...

def uuid7() -> uuid.UUID: ...
def uuid7_at(*, unix_ms: builtins.int) -> uuid.UUID: ...
def uuid7_at_many(*, unix_ms: Iterable[builtins.int]) -> list[uuid.UUID]: ...
def uuid7_obj() -> UUID7Obj: ...
def uuid7_str() -> builtins.str: ...
def uuid7_bytes() -> builtins.bytes: ...
def uuid7_many(count: builtins.int) -> list[uuid.UUID]: ...
def uuid7_obj_many(count: builtins.int) -> list[UUID7Obj]: ...
def uuid7_str_many(count: builtins.int) -> list[builtins.str]: ...
def uuid7_bytes_many(count: builtins.int) -> builtins.bytes: ...

__version__: builtins.str

def uuid4() -> uuid.UUID: ...
def uuid4_str() -> builtins.str: ...
def uuid4_bytes() -> builtins.bytes: ...
def uuid4_many(count: builtins.int, /) -> list[uuid.UUID]: ...
def uuid4_str_many(count: builtins.int, /) -> list[builtins.str]: ...
def uuid4_bytes_many(count: builtins.int, /) -> builtins.bytes: ...
def parse(text: builtins.str, /) -> uuid.UUID: ...
def parse_many(texts: Iterable[builtins.str], /) -> list[uuid.UUID]: ...
def parse_bytes_many(texts: Iterable[builtins.str], /) -> builtins.bytes: ...
def format_uuid(value: uuid.UUID | UUID7Obj | builtins.bytes, /) -> builtins.str: ...
